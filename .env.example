# ============================================================
# Animation AI Agent 設定（このファイルを .env にコピーして使う）
# ============================================================

# --- LLM プロバイダ: gemini | anthropic | claude-code ---------
LLM_PROVIDER=claude-code

# gemini: Google AI Studio の API キー（https://aistudio.google.com/apikey）
GEMINI_API_KEY=

# anthropic: Claude API を直接呼ぶ場合
ANTHROPIC_API_KEY=

# claude-code: Claude Code CLI を裏で動かす場合（Claude サブスクリプションで利用可）
#   ホストで `claude setup-token` を実行し、表示されたトークンを貼る
CLAUDE_CODE_OAUTH_TOKEN=
# 用途別モデルの上書き（空ならプロバイダごとの既定値）
#   gemini 既定: gemini-3-flash-preview / claude-code 既定: sonnet, sonnet, haiku
LLM_MODEL_PRO=
LLM_MODEL_FLASH=
LLM_MODEL_LITE=

# --- Qual (Manim linter) -------------------------------------
# 報告する最小 confidence: certain | high | medium | low
QUAL_MIN_CONFIDENCE=medium
# 自動修正: unsafe（機械的な修正も適用・推奨）| safe | off
QUAL_FIX_MODE=unsafe

# --- その他 ----------------------------------------------------
DEFAULT_LANGUAGE=ja

